# VentureTwin Environment Configuration

# LLM Execution Mode: mock | real | record | replay
# - mock: Fast, deterministic offline run with synthetic agent assumptions
# - real: Live calls to the configured LLM provider
# - record: Live calls recorded into tests/cassettes/ for reproducible replay
# - replay: Exact offline replay from committed cassettes without network calls
LLM_MODE=mock

# LLM Provider: gemini | openai | anthropic | openai_compatible
LLM_PROVIDER=gemini

# LLM Model ID: Select an active, available model identifier
# Gemini: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
# OpenAI: gpt-4o, gpt-4o-mini
# Run scripts/list_gemini_models.py to inspect currently available Gemini models for your key
LLM_MODEL=gemini-2.5-flash

# API Keys (Do not commit real keys to version control!)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Maximum concurrent LLM requests (avoids provider rate limits and 429 quota errors)
LLM_MAX_CONCURRENCY=2

# CORS Allowed Origins (comma-separated list for local frontend dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://localhost:3000

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
